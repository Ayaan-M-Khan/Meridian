{
  "name": "ai-command-center",
  "productName": "AI Command Center",
  "version": "0.2.0",
  "description": "One dashboard for your AI tools: what's running, what's next, what you've spent, and what needs attention.",
  "author": "AI Command Center",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "app": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win --x64",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "chart.js": "^4.6.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.aicommandcenter.desktop",
    "productName": "AI Command Center",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Command Center",
      "artifactName": "AI-Command-Center-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
